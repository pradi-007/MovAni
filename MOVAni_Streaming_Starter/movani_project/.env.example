# Copy this file to .env and fill in values. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
PORT=5000

# TMDB: use one of these. Read Access Token is recommended.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Admin API basic authentication. Generate a password hash with:
# py -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-this-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

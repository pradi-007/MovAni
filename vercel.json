{
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,frontend/**,movani.db,*.html,css/**,js/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/login.html?action=register"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/login.html",
      "destination": "/login.html"
    },
    {
      "source": "/frontend/login",
      "destination": "/login.html"
    },
    {
      "source": "/frontend/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/home",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/css/(.*)",
      "destination": "/css/$1"
    },
    {
      "source": "/frontend/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/frontend/(.*)",
      "destination": "/$1"
    }
  ]
}
